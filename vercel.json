{
  "version": 2,
  "builds": [{
    "src": "/api/index.php",
    "use": "vercel-php@0.7.3",
    "config": {
      "memory": 1024,
      "maxDuration": 30,
      "runtime": "php-8.3",
      "buildCommand": "composer install --no-dev --optimize-autoloader && npm ci && npm run build && php artisan package:discover --ansi",
      "writableDirs": ["storage", "bootstrap/cache"],
      "extensions": ["pdo_pgsql", "mbstring", "xml", "curl", "zip", "bcmath", "gd"],
      
    }
  }, { "src": "/public/**", "use": "@vercel/static" }],
  "routes": [
    { "src": "/(build|images)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "crons": [
    { "path": "/cron/orders-expire", "schedule": "0 17 * * *" }
  ]
}